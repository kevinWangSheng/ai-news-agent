# ai-agent-hub backend env 模板 — 复制为 .env 后填入真实密钥
# .env 永远不要提交 git

# ===== DB =====
DATABASE_URL=postgresql+asyncpg://hub:hub@localhost:5432/hub

# ===== LLM =====
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# OpenAI 仅作 embedding fallback
OPENAI_API_KEY=

# ===== Ingestion =====
EXA_API_KEY=
GITHUB_TOKEN=
TWITTER_BEARER_TOKEN=

# ===== Tunables(可覆盖 app/config.py 默认值)=====
